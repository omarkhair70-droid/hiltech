<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="HILTECH Spike"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".e2e.Spike15Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hiltech.spike.SPIKE15_PREPARE" />
                <action android:name="com.hiltech.spike.SPIKE15_QUEUE_OFFLINE" />
                <action android:name="com.hiltech.spike.SPIKE15_ENQUEUE_SYNC" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sync.SyncSpikeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.hiltech.spike.ENQUEUE_SYNC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
